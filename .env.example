# Copy to .env.local and fill in real values. Never commit .env.local.

# Gmail account used by app/api/send-booking-email to send booking notifications.
# Use a Google App Password (https://myaccount.google.com/apppasswords), not the account password.
GMAIL_USER=notifications@example.com
GMAIL_APP_PASSWORD=your-16-character-app-password

# Inbox that receives new-booking notification emails.
BOOKING_NOTIFICATION_EMAIL=owner@example.com
